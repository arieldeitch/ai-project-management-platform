<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Soft dark "control room at dusk" surface. Never near-black. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/ct_accent</item>
        <item name="android:statusBarColor">@color/ct_bg</item>
        <item name="android:navigationBarColor">@color/ct_nav</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/ct_bg</item>
    </style>
</resources>
