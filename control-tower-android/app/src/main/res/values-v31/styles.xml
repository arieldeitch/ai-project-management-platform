<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: same brand mark, same dark surface. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/ct_accent</item>
        <item name="android:statusBarColor">@color/ct_bg</item>
        <item name="android:navigationBarColor">@color/ct_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/ct_bg</item>
        <item name="android:windowSplashScreenBackground">@color/ct_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
